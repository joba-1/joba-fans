# KiCad backups and locks
*-backups/
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak
_autosave-*
fp-info-cache
*.lck
*.kicad_prl
.history/

# KiCad plot output and regenerable exports
gerbers/
*.zip
*.net

# Python
__pycache__/

# OS
.DS_Store

# Fab package: the gerbers and the zip are regenerable via
# fan-controller/scripts/make_fab.sh. The BOM and CPL are tracked - they are
# reviewable and get hand-edited (MPN / supplier columns).
fan-controller/fab/gerbers/
fan-controller/fab/*.zip

# Status file the slicer drops next to its export
result.json

# G-code is not source: it can always be regenerated from the STL/FCStd files
# and was the biggest item in the history (62 MB) before it was removed.
*.gcode
