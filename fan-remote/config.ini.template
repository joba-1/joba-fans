; config.ini.template — fan-remote
; Build-time defaults. pre_build.py copies this to config.ini on the first build, swaps the
; admin_password placeholder for a random password and prints it. config.ini is gitignored.
;
; Everything below can be changed per board at runtime
; (web UI settings or POST /api/netconfig) and is then kept in NVS; these values
; are only the defaults of a fresh board. See docs/admin.md.

[user_config]
; One password for the settings login, the setup access point and OTA on every board
; flashed from this tree (min. 8 characters: WPA2 needs that for the AP). Keep this file
; mode 600; it is the only place the password is stored besides the boards themselves.
admin_password = @RANDOM@
admin_user = admin

; Service aliases (dnsmasq CNAMEs); never hard-code hosts or IPs.
mqtt_host = mqtt
mqtt_port = 1883
mqtt_user =
mqtt_password =
mqtt_prefix = fan-control        ; topics: <prefix>/<device id>/...
ha_prefix = homeassistant        ; Home Assistant discovery prefix
syslog_host = syslog             ; empty = no syslog
syslog_port = 514
ntp_host = de.pool.ntp.org
; Standby: full power (160 MHz, WiFi awake) for idle_seconds after any user interaction
; (page load, button, HA/MQTT command, settings, OTA), then WiFi modem sleep and a lower CPU
; clock. power_save = 0 keeps the board at full power all the time. Never below 80 MHz:
; WiFi needs it and the PWM timer clock is derived from it.
power_save = 1
idle_seconds = 60
cpu_active_mhz = 160
cpu_idle_mhz = 80
timezone = CET-1CEST,M3.5.0,M10.5.0/3
; Status LED (boards that have one; the XIAO ESP32-C6 has a yellow user LED). led_mode 0 = off
; (dark operation), 1 = on. Brightness in percent, lower at night; the night window is in whole
; hours of local time (night_from > night_to wraps over midnight). All of it is editable in the
; web settings; these are only the defaults of a fresh board.
led_mode = 1
led_day = 30
led_night = 5
night_from = 22
night_to = 7
